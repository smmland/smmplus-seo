DATABASE_URL="postgresql://seo:seo@localhost:5432/smmplus_seo?schema=public"

# Main site sitemap we mirror and categorize
SOURCE_SITEMAP_URL="https://smm.plus/sitemap.xml"

# Public base URL of this SEO panel/subdomain (used inside generated sitemap files)
PUBLIC_BASE_URL="https://seo.smm.plus"

# Default sync interval in hours, can also be changed at runtime from the panel (stored in the Setting table)
DEFAULT_SYNC_INTERVAL_HOURS=6

JWT_SECRET="change-me"
JWT_EXPIRES_IN="12h"

PORT=3000

# Seed admin user (used once by `npm run seed`)
ADMIN_EMAIL="admin@smm.plus"
ADMIN_PASSWORD="change-me"
